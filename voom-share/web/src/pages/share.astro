---
import Base from '../layouts/Base.astro';
import LoadingState from '../components/LoadingState.astro';
import PasswordGate from '../components/PasswordGate.astro';
import ExpiredView from '../components/ExpiredView.astro';
---

<Base title="Voom">
  <LoadingState />
  <PasswordGate />
  <ExpiredView />

  <div id="share-content" style="display:none">
    <!-- ── Top bar ── -->
    <header class="topbar">
      <div class="topbar-left">
        <a class="brand" href="https://github.com/aritropaul/voom" target="_blank" rel="noopener">
          <img src="/icon-64.png" alt="" />
          <span>Voom</span>
        </a>
        <div class="topbar-rule"></div>
        <h1 class="topbar-title" id="topbar-title"></h1>
      </div>
      <a class="topbar-cta" href="https://github.com/aritropaul/voom" target="_blank" rel="noopener">Get Voom</a>
    </header>

    <!-- ── Workspace: video column + persistent sidebar ── -->
    <div class="workspace">
      <main class="workspace-main">
        <div class="byline">
          <div class="byline-left">
            <img class="byline-mark" src="/icon-64.png" alt="" />
            <div class="byline-text">
              <span class="byline-meta" id="byline-meta"></span>
            </div>
          </div>
          <button class="copy-link-btn" id="copy-link-btn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            Copy link
          </button>
        </div>

        <div class="video-card">
          <div class="player-section" id="player-section">
            <video id="player" preload="metadata" playsinline></video>
            <div class="big-play" id="big-play">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="#fff"><polygon points="6,3 20,12 6,21"/></svg>
            </div>
            <div class="caption-overlay hidden" id="captions"><span></span></div>
            <div class="progress-bar-bottom" id="progress-bottom"><div class="fill" id="progress-fill"></div></div>
            <div class="controls" id="controls">
              <button id="ctrl-play" title="Play/Pause (K)">
                <svg id="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="6,3 20,12 6,21"/></svg>
                <svg id="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display:none"><rect x="5" y="3" width="4" height="18" rx="1"/><rect x="15" y="3" width="4" height="18" rx="1"/></svg>
              </button>

              <button id="ctrl-back" title="Back 5s">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><polygon points="11,5 3,12 11,19"/><polygon points="21,5 13,12 21,19"/></svg>
              </button>
              <button id="ctrl-fwd" title="Forward 5s">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><polygon points="13,5 21,12 13,19"/><polygon points="3,5 11,12 3,19"/></svg>
              </button>

              <div class="volume-group">
                <button id="ctrl-mute" title="Mute (M)">
                  <svg id="icon-vol" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                  <svg id="icon-mute" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                </button>
                <div class="volume-slider"><input type="range" id="volume-range" min="0" max="1" step="0.05" value="1"></div>
              </div>

              <span class="time-display" id="time-display">0:00 / 0:00</span>

              <div class="seekbar-container" id="seekbar">
                <div class="seekbar-track">
                  <div class="seekbar-buffered" id="seekbar-buffered"></div>
                  <div class="seekbar-fill" id="seekbar-fill"></div>
                </div>
                <div class="seekbar-thumb" id="seekbar-thumb"></div>
              </div>

              <div class="ctrl-spacer"></div>

              <div class="speed-wrap">
                <button class="speed-btn" id="ctrl-speed" title="Playback speed">1x</button>
                <div class="speed-menu" id="speed-menu">
                  <button data-speed="0.5">0.5x</button>
                  <button data-speed="1" class="active">1x</button>
                  <button data-speed="1.25">1.25x</button>
                  <button data-speed="1.5">1.5x</button>
                  <button data-speed="2">2x</button>
                </div>
              </div>

              <button id="ctrl-pip" title="Picture in picture">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><rect x="12" y="12" width="8" height="6" rx="1" fill="currentColor" stroke="none"/></svg>
              </button>

              <button id="ctrl-fs" title="Fullscreen (F)">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Reactions rail -->
        <div class="under-video">
          <div class="reactions-bar" id="reactions-bar">
            <button class="react-btn" data-emoji="👍"><span class="emoji">👍</span><span class="count" id="rc-0"></span></button>
            <button class="react-btn" data-emoji="❤️"><span class="emoji">❤️</span><span class="count" id="rc-1"></span></button>
            <button class="react-btn" data-emoji="😂"><span class="emoji">😂</span><span class="count" id="rc-2"></span></button>
            <button class="react-btn" data-emoji="😮"><span class="emoji">😮</span><span class="count" id="rc-3"></span></button>
            <button class="react-btn" data-emoji="🔥"><span class="emoji">🔥</span><span class="count" id="rc-4"></span></button>
            <button class="react-btn" data-emoji="👏"><span class="emoji">👏</span><span class="count" id="rc-5"></span></button>
            <div class="reactions-rule"></div>
            <button class="comment-jump" id="comment-jump">Comment</button>
          </div>
        </div>

        <!-- Summary + chapters -->
        <div class="info-card" id="info-card"></div>
      </main>

      <!-- ── Sidebar ── -->
      <aside class="sidebar">
        <div class="tabs" role="tablist">
          <button class="tab active" id="tab-comments" data-panel="comments" role="tab" aria-selected="true">
            Comments<span class="tab-count" id="comment-count"></span>
          </button>
          <button class="tab" id="tab-transcript" data-panel="transcript" role="tab" aria-selected="false">
            Transcript
          </button>
        </div>

        <div class="tab-panels">
          <div class="tab-panel active" data-panel="comments" role="tabpanel">
            <div class="comment-list" id="comment-list"></div>
          </div>
          <div class="tab-panel" data-panel="transcript" role="tabpanel">
            <div class="transcript-list" id="transcript-list"></div>
          </div>
        </div>

        <div class="composer" id="comment-form">
          <input type="text" id="comment-name" placeholder="Your name" maxlength="100">
          <textarea id="comment-text" placeholder="Add a comment at this moment…" maxlength="2000"></textarea>
          <div class="composer-footer">
            <button class="comment-ts-pill" id="comment-ts-pill" type="button" title="The moment this comment links to — click to use the current time">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/></svg>
              <span id="comment-ts-label">Commenting at 0:00</span>
            </button>
            <button id="comment-submit">Post</button>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <div class="toast" id="toast">Copied!</div>
</Base>

<script>
  import {
    fetchShareData,
    verifyPassword,
    isShareData,
    isPasswordRequired,
    isExpired,
    formatDuration,
    formatDate,
    formatTimestamp,
    escapeHTML,
  } from '../scripts/api';
  import type { ShareData } from '../scripts/api';
  import { initPlayer } from '../scripts/player';
  import { initReactions } from '../scripts/reactions';
  import { initComments } from '../scripts/comments';

  const path = window.location.pathname;
  const shareCode = path.split('/').pop() || '';

  const loadingEl = document.getElementById('loading-state')!;
  const passwordEl = document.getElementById('password-gate')!;
  const expiredEl = document.getElementById('expired-view')!;
  const contentEl = document.getElementById('share-content')!;

  function showView(view: 'loading' | 'password' | 'expired' | 'content') {
    loadingEl.style.display = view === 'loading' ? '' : 'none';
    passwordEl.style.display = view === 'password' ? '' : 'none';
    expiredEl.style.display = view === 'expired' ? '' : 'none';
    contentEl.style.display = view === 'content' ? '' : 'none';
  }

  async function loadShare() {
    const data = await fetchShareData(shareCode);

    if (isExpired(data)) {
      showView('expired');
      document.title = 'Recording Not Found — Voom';
      return;
    }

    if (isPasswordRequired(data)) {
      document.title = data.title + ' — Voom';
      showView('password');
      setupPassword();
      return;
    }

    if (isShareData(data)) {
      renderShare(data);
    }
  }

  function setupPassword() {
    const pwInput = document.getElementById('pw-input') as HTMLInputElement;
    const pwError = document.getElementById('pw-error')!;
    const pwSubmit = document.getElementById('pw-submit') as HTMLButtonElement;

    async function verify() {
      pwError.style.display = 'none';
      pwSubmit.textContent = 'Verifying...';
      pwSubmit.disabled = true;

      const ok = await verifyPassword(shareCode, pwInput.value);
      if (ok) {
        showView('loading');
        await loadShare();
      } else {
        pwError.style.display = 'block';
        pwSubmit.textContent = 'Unlock';
        pwSubmit.disabled = false;
        pwInput.focus();
        pwInput.select();
      }
    }

    pwSubmit.addEventListener('click', verify);
    pwInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') verify();
    });
    pwInput.focus();
  }

  function renderShare(data: ShareData) {
    const { video, segments, chapters, shareCode: code } = data;
    document.title = video.title + ' — Voom';

    const hasTranscript = segments.length > 0;
    const viewStr = video.view_count === 1 ? '1 view' : `${video.view_count.toLocaleString()} views`;

    // ── Header + byline ──
    document.getElementById('topbar-title')!.textContent = video.title;

    const metaParts = [formatDate(video.created_at), viewStr, formatDuration(video.duration)];
    if (video.width > 0) metaParts.push(`${video.width} × ${video.height}`);
    document.getElementById('byline-meta')!.innerHTML = metaParts
      .map((p, i) => (i > 0 ? `<span class="dot"></span><span>${p}</span>` : `<span>${p}</span>`))
      .join('');

    // ── Video source ──
    const vid = document.getElementById('player') as HTMLVideoElement;
    vid.poster = `/thumb/${code}`;
    const source = document.createElement('source');
    source.src = `/v/${code}`;
    source.type = 'video/mp4';
    vid.appendChild(source);

    if (hasTranscript) {
      const track = document.createElement('track');
      track.kind = 'captions';
      track.src = `/vtt/${code}`;
      track.srclang = 'en';
      track.label = 'English';
      track.default = true;
      vid.appendChild(track);

      const ccBtn = document.createElement('button');
      ccBtn.className = 'cc-ctrl on';
      ccBtn.id = 'cc-btn';
      ccBtn.title = 'Toggle captions (C)';
      ccBtn.textContent = 'CC';
      const speedWrap = document.querySelector('.speed-wrap')!;
      speedWrap.parentNode!.insertBefore(ccBtn, speedWrap);
    }

    // CTA overlay
    if (video.cta_url) {
      const ctaDiv = document.createElement('div');
      ctaDiv.className = 'cta-overlay';
      ctaDiv.id = 'cta-overlay';
      ctaDiv.innerHTML = `<a href="${escapeHTML(video.cta_url)}" target="_blank" rel="noopener">${escapeHTML(video.cta_text || 'Learn More')}</a><button class="cta-replay" id="cta-replay">Replay</button>`;
      document.getElementById('player-section')!.appendChild(ctaDiv);
    }

    // ── Summary + chapters card ──
    const infoCard = document.getElementById('info-card')!;
    let info = '';

    if (video.summary) {
      info += `<section class="info-block">
        <div class="info-head">
          <h2>Summary</h2>
          <span class="info-caption">Generated on-device</span>
        </div>
        <p class="info-body">${escapeHTML(video.summary)}</p>
      </section>`;
    }

    if (chapters.length > 0) {
      info += `<section class="info-block">
        <div class="info-head"><h2>Chapters</h2></div>
        <div class="chapters-list">
          ${chapters.map(c => `<div class="chapter-row" data-time="${c.timestamp}">
            <span class="timestamp">${formatTimestamp(c.timestamp)}</span>
            <span class="chapter-title">${escapeHTML(c.title)}</span>
          </div>`).join('')}
        </div>
      </section>`;
    }

    infoCard.innerHTML = info;

    // ── Transcript panel ──
    const transcriptList = document.getElementById('transcript-list')!;
    if (hasTranscript) {
      transcriptList.innerHTML = segments.map(s => `<div class="transcript-row" data-start="${s.start_time}">
        <div class="seg-head">
          <span class="timestamp">${formatTimestamp(s.start_time)}</span>
          ${s.speaker ? `<span class="speaker-label">${escapeHTML(s.speaker)}</span>` : ''}
          <button class="copy-ts" title="Copy link to this timestamp" data-time="${s.start_time}">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </button>
        </div>
        <span class="text">${escapeHTML(s.text)}</span>
      </div>`).join('');
    } else {
      document.getElementById('tab-transcript')!.style.display = 'none';
      transcriptList.innerHTML = '';
    }

    showView('content');

    // ── Tabs ──
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.tab-panel'));

    function selectTab(name: string) {
      tabs.forEach(t => {
        const on = t.dataset.panel === name;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', String(on));
      });
      panels.forEach(p => p.classList.toggle('active', p.dataset.panel === name));
    }

    tabs.forEach(t => t.addEventListener('click', () => selectTab(t.dataset.panel!)));

    // ── Seeking ──
    // The player is always on screen now, so seeking is just a time set —
    // scroll it into view when the click came from far down the page.
    function seek(t: number) {
      vid.currentTime = t;
      const rect = document.getElementById('player-section')!.getBoundingClientRect();
      if (rect.top < 0 || rect.bottom > window.innerHeight) {
        document.getElementById('player-section')!.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    initPlayer({
      shareCode: code,
      segments,
      chapters,
      hasCTA: !!video.cta_url,
    });

    initReactions(code, () => vid.currentTime || 0);
    initComments(code, vid, seek);

    // Jump to the composer from the reactions rail.
    document.getElementById('comment-jump')!.addEventListener('click', () => {
      selectTab('comments');
      (document.getElementById('comment-text') as HTMLTextAreaElement).focus();
    });

    // Chapter + transcript rows seek the player.
    infoCard.querySelectorAll('.chapter-row').forEach(el => {
      el.addEventListener('click', () => {
        seek(parseFloat((el as HTMLElement).dataset.time || '0'));
      });
    });

    transcriptList.querySelectorAll('.transcript-row').forEach(el => {
      el.addEventListener('click', (e) => {
        if ((e.target as Element).closest('.copy-ts')) return;
        seek(parseFloat((el as HTMLElement).dataset.start || '0'));
      });
    });
  }

  loadShare().catch(() => {
    showView('expired');
  });
</script>

<style is:global>
  :root {
    --comment-accent: rgba(255, 255, 255, 0.9);
    --comment-accent-soft: rgba(255, 255, 255, 0.05);
    --comment-accent-soft-hover: rgba(255, 255, 255, 0.1);
  }

  /* ══════════════════════════════════════════════════════════
     Player surface
     ══════════════════════════════════════════════════════════ */
  .player-section {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius-m);
    overflow: hidden;
    cursor: pointer;
  }

  .player-section video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }

  .big-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: opacity 0.2s;
    z-index: 3;
  }

  .big-play svg { margin-left: 3px; }
  .player-section.playing .big-play { opacity: 0; }
  .player-section:hover .big-play { opacity: 1; }
  .player-section.playing:hover .big-play { opacity: 0; }
  .player-section.hide-cursor { cursor: none; }

  .progress-bar-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    z-index: 3;
    pointer-events: none;
  }

  .progress-bar-bottom .fill {
    height: 100%;
    background: var(--accent);
    width: 0%;
    transition: width 0.1s linear;
  }

  /* ── Control bar ── */
  .controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 22px 12px 10px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.55) 45%, rgba(0, 0, 0, 0.8));
    opacity: 0;
    transition: opacity 0.25s;
    z-index: 4;
    pointer-events: none;
  }

  .controls.visible { opacity: 1; pointer-events: auto; }

  .controls button {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.82);
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-s);
    transition: color 0.15s, background 0.15s;
  }

  .controls button:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .ctrl-spacer { flex: 0 0 4px; }
  .speed-wrap { position: relative; }

  /* ── Seekbar ── */
  .seekbar-container {
    flex: 1 1 auto;
    min-width: 60px;
    display: flex;
    align-items: center;
    height: 30px;
    position: relative;
    cursor: pointer;
    margin: 0 6px;
  }

  .seekbar-track {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.22);
    border-radius: 2px;
    position: relative;
    transition: height 0.15s;
  }

  .seekbar-container:hover .seekbar-track { height: 6px; }

  .seekbar-buffered {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: rgba(255, 255, 255, 0.18);
    border-radius: 2px;
  }

  .seekbar-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: #fff;
    border-radius: 2px;
  }

  .seekbar-thumb {
    position: absolute;
    top: 50%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.15s;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .seekbar-container:hover .seekbar-thumb { opacity: 1; }

  /* Chapter dividers cut the track into segments, like the reference. */
  .seekbar-marker {
    position: absolute;
    top: 0;
    width: 2px;
    height: 100%;
    background: #000;
    opacity: 0.55;
    pointer-events: none;
    z-index: 2;
  }

  .time-display {
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.75);
    white-space: nowrap;
    user-select: none;
    font-variant-numeric: tabular-nums;
    padding: 0 4px;
  }

  .volume-group { display: flex; align-items: center; gap: 2px; }
  .volume-slider { width: 0; overflow: hidden; transition: width 0.2s; display: flex; align-items: center; }
  .volume-group:hover .volume-slider { width: 60px; }
  .volume-slider input[type=range] {
    width: 56px;
    height: 4px;
    -webkit-appearance: none;
    appearance: none;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }
  .volume-slider input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #fff;
    cursor: pointer;
  }

  .speed-btn { font-family: var(--font-mono); font-size: 11px; min-width: 30px; }

  .speed-menu {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(17, 17, 19, 0.97);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-hover);
    border-radius: var(--radius-m);
    padding: 4px 0;
    display: none;
    flex-direction: column;
    min-width: 66px;
    margin-bottom: 10px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }

  .speed-menu.open { display: flex; }
  .speed-menu button {
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-align: center;
    color: rgba(255, 255, 255, 0.7);
    white-space: nowrap;
    border-radius: 0;
  }
  .speed-menu button:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
